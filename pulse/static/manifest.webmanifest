{
  "id": "/",
  "name": "Pulse \u2014 student news",
  "short_name": "Pulse",
  "description": "A personalised news app for students and teens: 300+ sources, live scores, AI overviews, a permanent searchable archive, study tools and zero ads.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0a0c11",
  "theme_color": "#0a0c11",
  "categories": [
    "news",
    "education",
    "magazines"
  ],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Pulse Shorts",
      "short_name": "Shorts",
      "url": "/reels",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Today's brief",
      "short_name": "Brief",
      "url": "/brief",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Live scores",
      "short_name": "Scores",
      "url": "/sports",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Search the archive",
      "short_name": "Search",
      "url": "/search",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "screenshots": [
    {
      "src": "/screenshots/home-wide.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Your front page"
    },
    {
      "src": "/screenshots/onboarding-wide.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Choose a reading level for your age"
    },
    {
      "src": "/screenshots/article-wide.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Reading with photo galleries"
    },
    {
      "src": "/screenshots/shorts-narrow.png",
      "sizes": "860x1864",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Pulse Shorts"
    },
    {
      "src": "/screenshots/home-narrow.png",
      "sizes": "860x1864",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The front page on mobile"
    }
  ]
}