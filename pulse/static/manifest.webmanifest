{
  "id": "/",
  "name": "Pulse — Student News",
  "short_name": "Pulse",
  "description": "A personalised news app for students and teens: 360+ sources, video from newsrooms and YouTube, live scores, AI overviews, a permanent searchable archive, study tools and zero ads.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0a0c11",
  "theme_color": "#0a0c11",
  "categories": [
    "news",
    "education",
    "magazines"
  ],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192-v20.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-v20.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-v20.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-v20.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Pulse Shorts",
      "short_name": "Shorts",
      "url": "/reels",
      "icons": [
        {
          "src": "/icons/icon-192-v20.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Watch video",
      "short_name": "Watch",
      "url": "/videos",
      "icons": [
        {
          "src": "/icons/icon-192-v20.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Today's brief",
      "short_name": "Brief",
      "url": "/brief",
      "icons": [
        {
          "src": "/icons/icon-192-v20.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Live scores",
      "short_name": "Scores",
      "url": "/sports",
      "icons": [
        {
          "src": "/icons/icon-192-v20.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Search the archive",
      "short_name": "Search",
      "url": "/search",
      "icons": [
        {
          "src": "/icons/icon-192-v20.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Impact report",
      "short_name": "Impact",
      "url": "/impact",
      "icons": [
        {
          "src": "/icons/icon-192-v20.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Pulse Arcade",
      "short_name": "Arcade",
      "url": "/arcade",
      "icons": [
        {
          "src": "/icons/icon-192-v20.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "screenshots": [
    {
      "src": "/screenshots/welcome-wide.png",
      "sizes": "1440x900",
